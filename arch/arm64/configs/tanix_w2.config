# Tanix W2 (mademoiselle) additions to lineage_kvim1s_defconfig, merged by the LineageOS build
# (BoardConfig.mk: TARGET_KERNEL_CONFIG := lineage_kvim1s_defconfig tanix_w2.config).

# Zero-initialise all stack variables, as the stock Tanix W2 kernel does.
# CONFIG_INIT_STACK_NONE is not set
CONFIG_INIT_STACK_ALL_ZERO=y
